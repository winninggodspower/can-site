# Django Settings
SECRET_KEY="your-django-secret-key-here"
DEBUG=True

# PostgreSQL Database URL (used when DEBUG=False)
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Static and Media Files Settings
STATIC_ROOT="/path/to/project/staticfiles"
MEDIA_ROOT="/path/to/project/media"

# Cloudinary media storage (required for publication file uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Paystack Integration Keys
PAYSTACK_SECRET_KEY="pk_live_..."
PAYSTACK_PUBLIC_KEY="sk_live_..."

# CI/CD Deployment Settings
DEPLOY_SECRET="your-cicd-deploy-token"
PROJECT_PATH="/path/to/project/root"
VENV_PATH="/path/to/project/venv/bin/activate"

# ZeptoMail SMTP Settings
EMAIL_HOST="smtp.zeptomail.com"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER="emailapikey"
EMAIL_HOST_PASSWORD="your-zeptomail-send-mail-token"
DEFAULT_FROM_EMAIL="Church Arise Network <tickets@yourdomain.com>"
